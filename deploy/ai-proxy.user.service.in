# Per-user systemd unit template (systemctl --user, no root). The installer fills in the
# @PLACEHOLDERS@ and writes it to ~/.config/systemd/user/ai-proxy.service.
# By hand: replace placeholders, copy there, then
#   systemctl --user daemon-reload && systemctl --user enable --now ai-proxy
#   loginctl enable-linger "$USER"   # so it keeps running after logout / across reboots
[Unit]
Description=AI Proxy (LLM traffic inspector)
After=network-online.target

[Service]
Type=simple
EnvironmentFile=@ENVFILE@
ExecStart=@EXECSTART@
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
