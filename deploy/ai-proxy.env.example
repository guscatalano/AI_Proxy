# AI Proxy configuration — copy to the location the service reads (the installer does this)
# and edit. All values are optional; sensible defaults apply when unset.

# --- Networking ---
PROXY_HOST=127.0.0.1
PROXY_PORT=8000

# --- Upstreams ---
OLLAMA_URL=http://localhost:11434
ANTHROPIC_URL=https://api.anthropic.com
# LMSTUDIO_URL=http://localhost:1234

# --- State (writable) ---
# Where the SQLite DB, rules.json, and generated images are stored.
# PROXY_STATE_DIR=/var/lib/ai-proxy
# PROXY_DB=/var/lib/ai-proxy/proxy.db

# --- Privacy ---
# Redact request/response bodies for cross-subnet viewers (1=on).
PROXY_REDACT_PII=1

# --- Performance / storage guards ---
# Cap persisted request/response body size in bytes (0 = unlimited). Prevents a few huge
# turns from bloating the DB and slowing the analytics queries.
PROXY_MAX_STORED_BODY=262144
# Prune stored requests older than this many days (0 = keep forever).
PROXY_REQUEST_RETENTION_DAYS=30
# Seconds to cache the expensive stats/suggestions endpoints (0 = no caching).
PROXY_ANALYTICS_CACHE_TTL=5

# --- Optional HTTPS (serve the phone PWA over TLS) ---
# PROXY_HTTPS_PORT=8443
# PROXY_SSL_CERT=/etc/ai-proxy/cert.pem
# PROXY_SSL_KEY=/etc/ai-proxy/key.pem
